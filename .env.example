# SERVER ONLY. Copy to .env; never use VITE_ prefixes for keys.
# Create a key at https://aistudio.google.com/apikey in a free-tier project.
NUDGE_GEMINI_API_KEY=replace_with_your_google_ai_studio_key
# Optional: choose a model currently offered on your project's free tier.
NUDGE_GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3001
